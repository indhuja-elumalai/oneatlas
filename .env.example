# Copy this file to .env and fill in real values. Never commit .env.
# Neon: use the POOLED connection string here (host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon: the DIRECT (non-pooled) string, used by prisma db push / migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Plain-English model finder (Gemini first, Groq as fallback; both optional)
GEMINI_API_KEY=""
GROQ_API_KEY=""
